# .env.example
#
# Copy this file to .env and fill in the values. Do not commit .env.

# Agents, speech-to-text and text-to-speech (default profiles).
OPENAI_API_KEY=""

# Gemini profiles (*-gemini, stt.gemini, tts.gemini). GEMINI_API_KEY is also accepted.
GOOGLE_API_KEY=""

# Optional: override redis_url from configs/memory/default.toml (default redis://localhost:6379/0).
# docker/docker-compose.yml sets this for the container; leave it unset when running on the host.
# SYNNEON_REDIS_URL="redis://localhost:6379/0"
